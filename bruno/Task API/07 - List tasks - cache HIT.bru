meta {
  name: List tasks - cache HIT
  type: http
  seq: 7
}

get {
  url: {{taskApiUrl}}/tasks
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

tests {
  test('List tasks - cache HIT', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader('x-cache')).to.equal('HIT');
  });
}
