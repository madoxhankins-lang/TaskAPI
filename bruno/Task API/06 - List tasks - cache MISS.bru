meta {
  name: List tasks - cache MISS
  type: http
  seq: 6
}

get {
  url: {{taskApiUrl}}/tasks
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

tests {
  test('List tasks - cache MISS', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader('x-cache')).to.equal('MISS');
    expect(res.getBody().data.tasks.some(t => t.id === bru.getEnvVar('taskId'))).to.equal(true);
  });
}
