meta {
  name: ADMIN list users - 200
  type: http
  seq: 20
}

get {
  url: {{taskApiUrl}}/admin/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test('ADMIN list users - 200', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.users).to.be.an('array');
    expect(res.getBody().data.users.every(u => !('passwordHash' in u))).to.equal(true);
  });
}
