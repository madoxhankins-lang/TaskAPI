{
  "name": "task-management-api",
  "version": "1.0.0",
  "private": true,
  "description": "WD 2200 final project: authenticated task API with PostgreSQL and Redis",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "setup": "node scripts/setup.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --config jest.integration.config.cjs",
    "test:coverage": "jest --runInBand --coverage",
    "test:bruno": "node scripts/bruno.cjs",
    "postinstall": "prisma generate",
    "test:prepare": "node scripts/prepare-tests.cjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "6.19.3",
    "redis": "^4.7.0",
    "winston": "^3.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.1",
    "@types/supertest": "^6.0.3",
    "@usebruno/cli": "^3.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
